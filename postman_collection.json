{
  "info": {
    "name": "ImCam Hub Backend",
    "description": "API collection for ImCam Hub backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response has token', () => { const d = pm.response.json(); pm.expect(d).to.have.property('token'); });",
                  "pm.test('Response has user without password_hash', () => { const u = pm.response.json().user; pm.expect(u).to.have.property('id'); pm.expect(u).to.not.have.property('password_hash'); });",
                  "pm.environment.set('authToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"fullName\": \"Test User\"\n}"
            }
          }
        },
        {
          "name": "POST /api/auth/register — duplicate email (expect 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 409', () => pm.response.to.have.status(409));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"fullName\": \"Test User\"\n}"
            }
          }
        },
        {
          "name": "POST /api/auth/register — missing fields (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bad\"\n}"
            }
          }
        },
        {
          "name": "POST /api/auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns token', () => pm.expect(pm.response.json()).to.have.property('token'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "POST /api/auth/login — wrong password (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"wrongpassword\"\n}"
            }
          }
        },
        {
          "name": "GET /api/auth/me",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns user without password_hash', () => { const u = pm.response.json().user; pm.expect(u).to.not.have.property('password_hash'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          }
        },
        {
          "name": "GET /api/auth/me — no token (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Demo Requests",
      "item": [
        {
          "name": "POST /api/demo-requests",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Returns demo request data', () => pm.expect(pm.response.json().data).to.have.property('id'));",
                  "pm.environment.set('demoRequestId', pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/demo-requests",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"Acme Immigration Law\",\n  \"fullName\": \"Jane Doe\",\n  \"email\": \"jane@acme.com\",\n  \"phone\": \"+1 555 123 4567\",\n  \"firmSize\": \"11-50\",\n  \"message\": \"We need better case tracking.\"\n}"
            }
          }
        },
        {
          "name": "POST /api/demo-requests — missing fields (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/demo-requests",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"Acme\"\n}"
            }
          }
        },
        {
          "name": "POST /api/demo-requests — invalid email (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/demo-requests",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"Acme\",\n  \"fullName\": \"Jane\",\n  \"email\": \"not-an-email\",\n  \"firmSize\": \"1-10\"\n}"
            }
          }
        },
        {
          "name": "POST /api/demo-requests — invalid firm size (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/demo-requests",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"Acme\",\n  \"fullName\": \"Jane\",\n  \"email\": \"jane@test.com\",\n  \"firmSize\": \"invalid\"\n}"
            }
          }
        },
        {
          "name": "GET /api/demo-requests (admin, list)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns paginated results', () => { const d = pm.response.json(); pm.expect(d).to.have.property('data'); pm.expect(d).to.have.property('pagination'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/demo-requests?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api", "demo-requests"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] },
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          }
        },
        {
          "name": "GET /api/demo-requests — no auth (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/demo-requests"
          }
        },
        {
          "name": "GET /api/demo-requests/:id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/demo-requests/{{demoRequestId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          }
        },
        {
          "name": "GET /api/demo-requests/:id — not found (expect 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 404', () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/demo-requests/00000000-0000-0000-0000-000000000000",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          }
        },
        {
          "name": "PATCH /api/demo-requests/:id — update status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.test('Status updated', () => pm.expect(pm.response.json().data.status).to.equal('contacted'));"]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/demo-requests/{{demoRequestId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"contacted\"\n}"
            }
          }
        },
        {
          "name": "PATCH /api/demo-requests/:id — invalid status (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/demo-requests/{{demoRequestId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"invalid\"\n}"
            }
          }
        }
      ]
    }
  ]
}
